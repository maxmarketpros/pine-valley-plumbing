---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import ContactForm from "./ContactForm.astro";
import Icon from "./Icon.astro";
import { business } from "../data/site";

interface Props {
  surface?: "wood" | "cream" | "paper" | "forest" | "forest-deep" | "gold";
  /** Prefix for the form field ids — override if two of these share a page. */
  idPrefix?: string;
  eyebrow?: string;
  heading?: string;
  lead?: string;
}

const {
  surface = "forest",
  idPrefix = "contact",
  eyebrow = "Contact",
  heading = "Get in Touch",
  lead = "Call, email, or send us a note — a real person gets back to you.",
} = Astro.props;

const details = [
  {
    icon: "phone",
    label: "Phone",
    value: business.navPhone,
    href: business.navPhoneTel,
    note: "Emergencies get moved to the front of the line.",
  },
  {
    icon: "mail",
    label: "Email",
    value: business.navEmail,
    href: business.navEmailHref,
    note: "Send photos of the problem and we'll come prepared.",
  },
  {
    icon: "map-pin",
    label: "Service Area",
    value: "Merrimack, NH",
    href: business.mapsUrl,
    note: business.serviceArea,
  },
];
---

<Section id="contact" surface={surface} class="contact-section">
  <SectionHeader eyebrow={eyebrow} heading={heading} lead={lead} align="left" />

  <div class="contact-section__grid">
    <ul class="contact-details">
      {details.map((d) => (
        <li class="contact-detail">
          <span class="icon-chip"><Icon name={d.icon} /></span>
          <div>
            <p class="contact-detail__label">{d.label}</p>
            <a href={d.href} class="contact-detail__value">{d.value}</a>
            <p class="contact-detail__note">{d.note}</p>
          </div>
        </li>
      ))}
    </ul>

    <ContactForm idPrefix={idPrefix} />
  </div>
</Section>

<style>
  .contact-section__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 3rem;
    margin-top: 2.75rem;
    align-items: start;
  }

  .contact-details {
    list-style: none;
    display: grid;
    gap: 2rem;
    margin: 0;
    align-content: start;
  }
  .contact-detail {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.1rem;
    align-items: start;
  }
  .contact-detail .icon-chip { flex-shrink: 0; }
  .contact-detail__label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-deep);
  }
  .contact-detail__value {
    display: inline-block;
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .contact-detail__value:hover { color: var(--color-gold); }
  .contact-detail__note {
    margin-top: 0.35rem;
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--on-cream-muted);
  }

  /* dark surrounds: gold labels, cream values, muted body */
  :global(.surface-wood) .contact-detail__label,
  :global(.surface-forest) .contact-detail__label,
  :global(.surface-forest-deep) .contact-detail__label { color: var(--color-gold); }
  :global(.surface-wood) .contact-detail__value,
  :global(.surface-forest) .contact-detail__value,
  :global(.surface-forest-deep) .contact-detail__value { color: var(--cream-100); }
  :global(.surface-wood) .contact-detail__note { color: var(--on-wood-body); }
  :global(.surface-forest) .contact-detail__note,
  :global(.surface-forest-deep) .contact-detail__note { color: var(--on-forest-body); }
  :global(.surface-forest) .contact-detail .icon-chip,
  :global(.surface-forest-deep) .contact-detail .icon-chip,
  :global(.surface-wood) .contact-detail .icon-chip {
    background: #ffffff17;
    color: var(--color-gold);
  }

  @media (max-width: 900px) {
    .contact-section__grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
